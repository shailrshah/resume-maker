<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{basics.name}}</title>
<style>{{{styles}}}</style>
</head>
<body>
<header class="header">
  <h1 class="name">{{basics.name}}</h1>
  <ul class="contact">
    {{#if basics.location}}<li>{{basics.location}}</li>{{/if}}
    {{#if basics.phone}}<li>{{basics.phone}}</li>{{/if}}
    {{#if basics.email}}<li><a href="mailto:{{basics.email}}">{{basics.email}}</a></li>{{/if}}
    {{#each basics.links}}<li><a href="{{url}}">{{label}}</a></li>{{/each}}
  </ul>
</header>
<main>
{{#each sections}}
  <section class="section section--{{name}}">{{> (lookup . "name")}}</section>
{{/each}}
</main>
</body>
</html>
